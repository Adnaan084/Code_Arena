# ─── Server (apps/server) ───────────────────────────────────────────────
# Postgres connection. Local Docker compose default (see docker-compose.yml).
# NOTE: host port is 5433 — a native Windows Postgres service usually owns
# 5432, so the container publishes on 5433 to stay unambiguous.
DATABASE_URL=postgresql://wcc:wcc_password@localhost:5433/wcc
# Test database (used by API/smoke tests). Must be a SEPARATE database.
TEST_DATABASE_URL=postgresql://wcc:wcc_password@localhost:5433/wcc_test

# HTTP port the API + Socket.IO listen on
PORT=4000

# Where the web UI is served from. In dev this is the Vite dev server
# (proxied): http://localhost:5173. In production behind Caddy, use the
# public https origin, or '*' to allow any (LAN mode).
WEB_ORIGIN=http://localhost:5173

# "true" when serving over public HTTPS/wss (Caddy/nginx terminating TLS).
# "false" for plain http/ws on a LAN.
TLS=false

# Host token entropy (bytes). 32 = 256-bit random host access key shown once.
HOST_TOKEN_BYTES=32

# Game config overrides (optional, everything has sensible defaults):
# STARTING_COINS=1000
# GAME_DURATION_MINUTES=30
# MAX_TEAMS=40
# MAX_ATTEMPTS=1
# MAX_TRADES_PER_QUESTION=2

# Log level: debug | info | warn | error
LOG_LEVEL=info

# ─── Web (apps/web) ─────────────────────────────────────────────────────
# Optional override. Omit to use same-origin (dev proxy / Caddy). If the
# API is hosted separately from the UI, set it explicitly.
# VITE_API_URL=https://game.example.com