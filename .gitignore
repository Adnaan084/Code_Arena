# Dependencies & build output
node_modules/
dist/
build/

# Environment (never commit secrets)
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*

# Tests
coverage/
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Prisma
apps/server/prisma/*.db
apps/server/prisma/*.db-journal

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Claude Code local settings (never share: per-machine permissions, paths, credentials)
.claude/settings.json
.claude/settings.local.json

# Local diagnostic scratch (the committed *.e2e.mjs harnesses stay tracked; diag-*.mjs is scratch)
apps/web/e2e-tmp/diag-*.mjs